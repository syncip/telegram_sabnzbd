# --- Telegram -------------------------------------------------------------
# Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Wer den Bot benutzen darf (kommagetrennt). Deine ID: @userinfobot fragen
# oder dem Bot schreiben, er antwortet mit "Kein Zugriff. Deine Telegram-ID ist ..."
ALLOWED_USER_IDS=

# --- Sprach-KI --------------------------------------------------------------
# gemini | anthropic | openai  (openai = alles OpenAI-kompatible: OpenAI, OpenRouter, Groq, Ollama ...)
LLM_PROVIDER=gemini
# Key für den gewählten Anbieter. Gemini: https://aistudio.google.com/apikey
LLM_API_KEY=
# Optional, sonst Standard: gemini-flash-latest / claude-opus-5-5 / gpt-4o-mini
LLM_MODEL=
# Nur für openai-kompatible Server, z. B. http://ollama:11434/v1 oder https://openrouter.ai/api/v1
LLM_BASE_URL=

# --- Radarr ---------------------------------------------------------------
RADARR_URL=http://radarr:7878
# Radarr -> Settings -> General -> API Key
RADARR_API_KEY=
# Optional (sonst erster Root-Ordner / erstes Profil)
RADARR_ROOT_FOLDER=
RADARR_QUALITY_PROFILE=
# announced | inCinemas | released
RADARR_MINIMUM_AVAILABILITY=released

# --- Sonarr ---------------------------------------------------------------
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=
SONARR_ROOT_FOLDER=
SONARR_QUALITY_PROFILE=

# --- Verhalten --------------------------------------------------------------
# Wie oft Radarr/Sonarr nach neuen Ereignissen gefragt werden
POLL_INTERVAL_SECONDS=60
# Nach wie vielen Minuten ohne gefundenen Download einmal Bescheid geben
NO_RELEASE_NOTICE_MINUTES=30
# Wie lange Serien nach der letzten Aktivität weiter beobachtet werden
TRACK_DAYS=30
# Nach so vielen Minuten Pause beginnt ein neues Gespräch
CONVERSATION_IDLE_MINUTES=30
LOG_LEVEL=INFO
